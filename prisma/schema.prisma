generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_POOLED")
  directUrl = env("DATABASE_URL")
}

model Supplier {
  id              Int           @id @default(autoincrement())
  url             String        @unique
  name            String
  agnicMerchantId String?        @unique
  status          String
  rail            String?
  currency        String?
  exploredAt      DateTime?
  explorePhase    String        @default("done")
  exploreOrderId  String?
  exploreError    String?
  catalogItems    CatalogItem[]
}

model CatalogItem {
  id         Int      @id @default(autoincrement())
  supplierId Int
  sku        String
  title      String
  priceMinor Int
  currency   String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, sku])
  @@index([title])
}

model Request {
  id              Int             @id @default(autoincrement())
  rawText         String
  parsedJson      String
  budgetMinor     Int
  createdAt       DateTime        @default(now())
  approvalBatches ApprovalBatch[]
  approvals       Approval[]
}

model ApprovalBatch {
  id               String     @id @default(cuid())
  requestId        Int
  cartsJson        String
  createdAt        DateTime   @default(now())
  confirmedAt      DateTime?
  confirmationText String?
  request          Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approvals        Approval[]

  @@index([requestId, createdAt])
}

model Approval {
  id                       String        @id @default(cuid())
  batchId                  String
  requestId                Int
  supplierName             String
  merchantId               String
  itemsJson                String
  displayItemsJson         String
  addressMode              String        @default("ship_to")
  shipToJson               String?
  constraintsJson          String
  amountMinor              Int
  currency                 String
  fulfillmentOptionId      String?
  userPrompt               String
  userConfirmationText     String
  userApprovedAt           DateTime
  status                   String        @default("approved")
  claimedAt                DateTime?
  agnicOrderId             String?       @unique
  approvalToken            String?
  approvalUrl              String?
  approvalExpiresAt        DateTime?
  dispatchResponseJson     String?
  orderResponseJson        String?
  amountChargedMinor       Int?
  retryable                Boolean?
  retryabilityKnown        Boolean       @default(false)
  retryAction              String?
  evidenceScreenshotsCount Int?
  evidenceUrl              String?
  decision                 String?
  decisionReason           String?
  refusalFigureMinor       Int?
  refusalCapMinor          Int?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  batch                    ApprovalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  request                  Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([batchId, merchantId])
  @@index([requestId, createdAt])
  @@index([status])
}
