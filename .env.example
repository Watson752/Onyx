# Postgres (Neon). Runtime uses the pooled connection; migrations use the
# direct one (see prisma/schema.prisma directUrl).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/dbname?sslmode=require"

AGNIC_TOKEN="replace_me"

LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY="replace_me"
LLM_MODEL="claude-sonnet-4-6"

SHIP_TO_NAME="Onyx Demo Cafe"
SHIP_TO_STREET="123 Queen St W"
SHIP_TO_CITY="Toronto"
SHIP_TO_REGION="Ontario"
SHIP_TO_POSTAL="M5H 2M9"
SHIP_TO_COUNTRY="CA"
